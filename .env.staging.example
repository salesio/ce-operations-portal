# CE Mozambique Dashboard — safe staging frontend template
# Copy locally to .env.staging. Never commit the populated file.

VITE_DATA_SOURCE=supabase
VITE_ENABLE_SUPABASE=true
VITE_ENABLE_STORAGE=false
VITE_ENABLE_REAL_AUTH=false
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY
VITE_API_BASE_URL=

# The anon key may be used by the frontend only with correctly tested RLS.
# Never paste backend/admin credentials into a VITE_* variable.

# Backend-only / never frontend (names documented; values intentionally absent):
# DATABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# JWT_SECRET=

# Optional shell-only live-test gate; false/absent means missing live env is skipped.
REQUIRE_SUPABASE_LIVE=false
